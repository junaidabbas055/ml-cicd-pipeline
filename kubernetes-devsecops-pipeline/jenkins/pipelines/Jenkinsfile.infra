/**
 * Infrastructure Pipeline — runs Ansible playbooks for server hardening and ELK provisioning.
 * Triggered manually or on changes to ansible/
 */
pipeline {
    agent { label 'ansible' }

    parameters {
        choice(name: 'PLAYBOOK',    choices: ['hardening', 'elk-stack', 'docker-setup', 'all'], description: 'Which playbook to run')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'],                        description: 'Target environment')
        booleanParam(name: 'DRY_RUN', defaultValue: true, description: 'Run in check mode (no changes)')
    }

    environment {
        ANSIBLE_HOST_KEY_CHECKING = 'False'
        ANSIBLE_STDOUT_CALLBACK   = 'yaml'
        ANSIBLE_FORCE_COLOR       = '1'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Validate Inventory') {
            steps {
                dir('kubernetes-devsecops-pipeline/ansible') {
                    sh "ansible-inventory -i inventory/${params.ENVIRONMENT}.ini --list"
                }
            }
        }

        stage('Lint Playbooks') {
            steps {
                dir('kubernetes-devsecops-pipeline/ansible') {
                    sh "ansible-lint playbook-${params.PLAYBOOK}.yml || true"
                }
            }
        }

        stage('Run Playbook') {
            steps {
                dir('kubernetes-devsecops-pipeline/ansible') {
                    withCredentials([sshUserPrivateKey(
                        credentialsId: "ssh-key-${params.ENVIRONMENT}",
                        keyFileVariable: 'SSH_KEY'
                    )]) {
                        sh """
                            ansible-playbook \
                                -i inventory/${params.ENVIRONMENT}.ini \
                                --private-key \$SSH_KEY \
                                ${params.DRY_RUN ? '--check --diff' : ''} \
                                -e "env=${params.ENVIRONMENT}" \
                                playbook-${params.PLAYBOOK}.yml
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'kubernetes-devsecops-pipeline/ansible/*.log', allowEmptyArchive: true
        }
    }
}
